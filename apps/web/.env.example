# Copy to apps/web/.env.local, then fill values from Firebase console -> Project settings -> Your apps.
# Firebase Web API keys are public identifiers, NOT Admin SDK service-account secrets.
# Use Firebase Authentication / Firestore Rules for access control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Development only: run Firebase emulators first, then set to true.
VITE_USE_FIREBASE_EMULATORS=false

# Firebase callable approval functions region. Default is us-central1.
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Phase 4: local for Spark-development trusted backend; functions for deployed Cloud Functions.
VITE_ORDER_API_MODE=local

# Phase 7 production: use cloudrun only with an HTTPS API URL.
# Set VITE_ORDER_API_MODE=cloudrun in your build environment (not local).
# VITE_ORDER_API_BASE_URL=https://YOUR-CLOUD-RUN-SERVICE-URL
# NEVER place Admin SDK credentials, service-account keys, or signing secrets here.
