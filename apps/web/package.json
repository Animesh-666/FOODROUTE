{
  "name": "@foodroute/web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "test:unit": "vitest run src/features",
    "test:ci": "npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "firebase": "^12.0.0",
    "react-router-dom": "^7.0.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/leaflet": "^1.9.20"
  }
}
